#!/bin/sh

# File size limit in bytes (100MB)
MAX_FILE_SIZE=104857600

# Check if Git LFS is installed
if ! command -v git-lfs &> /dev/null; then
    echo "Error: Git LFS is not installed. Please install it first."
    echo "Visit: https://git-lfs.github.com/"
    exit 1
fi

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only)

for file in $STAGED_FILES; do
    # Skip if file was deleted
    if [ ! -f "$file" ]; then
        continue
    fi

    # Get file size
    FILE_SIZE=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)

    # Check if file is tracked by Git LFS
    if ! git lfs status "$file" | grep -q "Git LFS objects to be committed"; then
        # If file is larger than limit and not tracked by LFS
        if [ "$FILE_SIZE" -gt "$MAX_FILE_SIZE" ]; then
            echo "Error: File '$file' is larger than 100MB and not tracked by Git LFS."
            echo "Please track it with Git LFS using: git lfs track \"$file\""
            exit 1
        fi
    fi
done

# Check for sensitive data patterns
SENSITIVE_PATTERNS=(
    "password\s*=\s*['\"][^'\"]+['\"]"
    "secret\s*=\s*['\"][^'\"]+['\"]"
    "api_key\s*=\s*['\"][^'\"]+['\"]"
    "private_key\s*=\s*['\"][^'\"]+['\"]"
)

for file in $STAGED_FILES; do
    # Skip binary files
    if file "$file" | grep -q "binary file"; then
        continue
    fi

    for pattern in "${SENSITIVE_PATTERNS[@]}"; do
        if grep -E "$pattern" "$file"; then
            echo "Error: Potential sensitive data found in '$file'"
            echo "Please remove or replace sensitive information before committing."
            exit 1
        fi
    done
done

exit 0 